<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Seat_Capacity_Cannot_be_Negative_CampMem</fullName>
    <active>false</active>
    <errorConditionFormula>AND (Campaign.Seats_Available__c &lt;=0)</errorConditionFormula>
    <errorMessage>You have exceeded the Seat Capacity, Please choose a lesser value.</errorMessage>
</ValidationRule>
