<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Name_field_should_be_Non_editable</fullName>
    <active>false</active>
    <errorConditionFormula>AND(OR(ISCHANGED(FirstName),ISCHANGED(LastName),ISCHANGED(MiddleName),ISCHANGED(Title)), $Permission.Skip_Validations_Permission = FALSE )</errorConditionFormula>
