<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Preferred_Address3</fullName>
    <active>true</active>
    <errorConditionFormula>$Permission.Skip_Validations_Permission = FALSE &amp;&amp; NOT(ISPICKVAL(Preferred_Address__c, &apos;&apos;)) &amp;&amp; NOT(Direct_Mail_Consent__c) &amp;&amp; (ISCHANGED(Direct_Mail_Consent__c) || ISCHANGED(Preferred_Address__c))</errorConditionFormula>
