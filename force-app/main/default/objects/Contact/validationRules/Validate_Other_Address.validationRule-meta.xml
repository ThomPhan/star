<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Other_Address</fullName>
    <active>true</active>
    <errorConditionFormula>AND($Permission.Skip_Validations_Permission = FALSE, ISCHANGED(OtherAddress), ISBLANK(OtherAddress))</errorConditionFormula>
    <errorMessage>Please enter a valid Residential address</errorMessage>
</ValidationRule>
