<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SOW_is_mandatory</fullName>
    <active>false</active>
    <errorConditionFormula>AND(Refused_to_provide_SOW__c = FALSE,
    ISBLANK(Source_of_Wealth_for_Individuals__c),
    ISBLANK(Source_of_Wealth__c),
    $Permission.Skip_Validations_Permission = FALSE
)</errorConditionFormula>
    <errorMessage>Unable to proceed as “SOW for Individuals“ or “SOW for Business” is blank</errorMessage>
</ValidationRule>
