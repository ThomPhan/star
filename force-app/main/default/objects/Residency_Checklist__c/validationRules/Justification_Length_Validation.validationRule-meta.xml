<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Justification_Length_Validation</fullName>
    <active>false</active>
    <errorConditionFormula>IF(AND(ISPICKVAL(Approval_Status__c, &apos;Approved&apos;), ISCHANGED(Approval_Status__c)), true, false)</errorConditionFormula>
    <errorMessage>Justification length should only be less than 300 characters</errorMessage>
</ValidationRule>
