<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Select_Other_Preferred_Dealer</fullName>
    <active>true</active>
    <errorConditionFormula>IF( $Permission.Skip_Validations_Permission, false,
AND(

ISBLANK(Preferred_Dealer__c),
INCLUDES(Preferred_Dealer__c, &apos;Other&apos;)
)
)</errorConditionFormula>
    <errorDisplayField>Other__c</errorDisplayField>
    <errorMessage>Please enter &quot;Other&quot; Preferred Dealer.</errorMessage>
</ValidationRule>
