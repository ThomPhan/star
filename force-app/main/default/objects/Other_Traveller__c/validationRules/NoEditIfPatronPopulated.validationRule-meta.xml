<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NoEditIfPatronPopulated</fullName>
    <active>true</active>
    <errorConditionFormula>IF( $Permission.Skip_Validations_Permission, false, 
not(isnew()) &amp;&amp; not(isblank(( Patron__c ))))</errorConditionFormula>
    <errorMessage>You cannot change any details if Patron has been populated.</errorMessage>
</ValidationRule>
