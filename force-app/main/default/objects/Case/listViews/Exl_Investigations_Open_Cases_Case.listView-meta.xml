<?xml version="1.0" encoding="UTF-8"?>
<ListView xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Exl_Investigations_Open_Cases_Case</fullName>
    <booleanFilter>1 AND 2 AND (3 OR 4) AND 5</booleanFilter>
    <columns>CASES.CASE_NUMBER</columns>
    <columns>NAME</columns>
    <columns>CASES.SUBJECT</columns>
    <columns>CASES.STATUS</columns>
    <columns>CASES.PRIORITY</columns>
    <columns>CASES.CREATED_DATE</columns>
    <columns>CORE.USERS.ALIAS</columns>
    <filterScope>Everything</filterScope>
    <filters>
        <field>CASES.RECORDTYPE</field>
        <operation>equals</operation>
        <value>Case.Exl_Apply_Exclusion</value>
    </filters>
    <filters>
        <field>CASES.STATUS</field>
        <operation>notEqual</operation>
        <value>Closed</value>
    </filters>
    <filters>
        <field>Exl_Nextbutton_NSW__c</field>
        <operation>notEqual</operation>
    </filters>
    <filters>
        <field>Exl_Nextbutton_Qld__c</field>
        <operation>notEqual</operation>
    </filters>
    <filters>
        <field>CASES.TYPE</field>
        <operation>equals</operation>
        <value>Police Exclusion in QLD,Police Exclusion in NSW,NICC Exclusion in NSW,Venue Exclusion in NSW,Venue Exclusion in QLD,WOL in NSW,WOL in QLD,WOL AML + Venue AML in NSW</value>
    </filters>
    <label>Investigations Open Cases</label>
    <sharedTo>
        <group>Exl_Exclusion_Admins</group>
        <group>Exl_Exclusion_Investigations_Users</group>
    </sharedTo>
</ListView>
