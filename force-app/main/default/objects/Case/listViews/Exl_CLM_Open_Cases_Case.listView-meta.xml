<?xml version="1.0" encoding="UTF-8"?>
<ListView xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Exl_CLM_Open_Cases_Case</fullName>
    <booleanFilter>1 AND 2 AND (3 OR 4) AND ( (5 AND 7 AND 8) OR (6 AND 8) OR 9)</booleanFilter>
    <columns>CASES.CASE_NUMBER</columns>
    <columns>NAME</columns>
    <columns>CASES.SUBJECT</columns>
    <columns>CASES.STATUS</columns>
    <columns>CASES.PRIORITY</columns>
    <columns>CASES.CREATED_DATE</columns>
    <columns>CORE.USERS.ALIAS</columns>
    <filterScope>Everything</filterScope>
    <filters>
        <field>CASES.RECORDTYPE</field>
        <operation>equals</operation>
        <value>Case.Exl_Apply_Exclusion</value>
    </filters>
    <filters>
        <field>CASES.STATUS</field>
        <operation>notEqual</operation>
        <value>Closed</value>
    </filters>
    <filters>
        <field>Exl_Nextbutton_NSW__c</field>
        <operation>notEqual</operation>
    </filters>
    <filters>
        <field>Exl_Nextbutton_Qld__c</field>
        <operation>notEqual</operation>
    </filters>
    <filters>
        <field>CASES.TYPE</field>
        <operation>equals</operation>
        <value>Self Exclusion in both states,Self Exclusion in NSW with Problem Gambling in Qld,Self Exclusion in QLD with Problem Gambling in NSW,Problem Gambling in both states</value>
    </filters>
    <filters>
        <field>CASES.TYPE</field>
        <operation>equals</operation>
        <value>Police Exclusion in QLD,Police Exclusion in NSW,NICC Exclusion in NSW</value>
    </filters>
    <filters>
        <field>Exl_Is_Weekend__c</field>
        <operation>equals</operation>
        <value>0</value>
    </filters>
    <filters>
        <field>Exl_ReplicatedStateEnabled__c</field>
        <operation>equals</operation>
        <value>1</value>
    </filters>
    <filters>
        <field>CASES.TYPE</field>
        <operation>equals</operation>
        <value>Venue Exclusion in NSW,Venue Exclusion in QLD,WOL in NSW,WOL in QLD,WOL AML + Venue AML in NSW</value>
    </filters>
    <label>CLM Open Cases</label>
    <sharedTo>
        <group>Exl_Exclusion_Admins</group>
        <group>Exl_Exclusion_CLM_Users</group>
    </sharedTo>
</ListView>
