<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Date_of_Birth_should_be_greater_than_18</fullName>
    <active>true</active>
    <errorConditionFormula>AND (YEAR(TODAY()) - YEAR( Date_of_Birth__c ) &lt;= 18, $Permission.Skip_Validations_Permission = FALSE)</errorConditionFormula>
    <errorDisplayField>Date_of_Birth__c</errorDisplayField>
    <errorMessage>Date of Birth should be greater than or equal to 18 years of age.</errorMessage>
</ValidationRule>
