<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Does_the_patron_drive_to_NSW</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISPICKVAL(Does_the_patron_have_travel_document__c, &apos;No&apos;),
ISBLANK(TEXT(Does_the_patron_drive_to_NSW__c))
)</errorConditionFormula>
    <errorDisplayField>Does_the_patron_drive_to_NSW__c</errorDisplayField>
    <errorMessage>Does the patron drive to NSW is required, if Does the Patron have Travel document is set to No</errorMessage>
</ValidationRule>
