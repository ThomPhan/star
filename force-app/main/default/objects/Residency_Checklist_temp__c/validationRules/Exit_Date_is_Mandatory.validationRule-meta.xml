<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Exit_Date_is_Mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>IF(  $Permission.Skip_Validations_Permission, false, 
AND( 

NOT(ISBLANK(Entry_Date__c)),

ISBLANK(Exit_Date__c)

))</errorConditionFormula>
    <errorDisplayField>Exit_Date__c</errorDisplayField>
    <errorMessage>Exit Date is Mandatory, if Entry date is filled in.</errorMessage>
</ValidationRule>
