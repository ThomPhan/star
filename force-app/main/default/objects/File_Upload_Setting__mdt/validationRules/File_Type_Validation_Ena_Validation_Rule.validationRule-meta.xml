<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>File_Type_Validation_Ena_Validation_Rule</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
File_Type_Validation_Enabled__c,
NOT(
REGEX(
Allowed_File_Types__c,
&quot;^[A-Za-z0-9_]+(,\\s*[A-Za-z0-9_]+)*$&quot;
)
)
)</errorConditionFormula>
    <errorMessage>Applicable File Type must be Valid and, comma-separated (e.g. pdf, docx, log)</errorMessage>
</ValidationRule>
