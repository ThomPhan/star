<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Exclusion Images</masterLabel>
    <description>Container for the Exclusion Evidence Gallery, exposed as a tab on the Contact record page.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <!-- Restrict the record-page placement to the Contact object only. -->
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Contact</object>
            </objects>
        </targetConfig>
        <!--
            NOTE: Per LWC metadata rules, the <property> tag is NOT supported for
            lightningCommunity__Page. recordId is supplied automatically on the
            Contact record page; configure any Experience Cloud bindings in the
            Experience Builder UI.
        -->
    </targetConfigs>
</LightningComponentBundle>